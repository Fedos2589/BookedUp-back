# Server secrets, copied to /opt/bookedup/.env (mode 600). Names and comments only: never commit real values.
# A copy of the real file lives in the password manager ("BookedUp server"); without it the backups can't be read.

# --- compose ---
DOMAIN=example.com
ACME_EMAIL=you@example.com
# openssl rand -hex 24  (hex, so DATABASE_URL needs no escaping)
POSTGRES_PASSWORD=
# written by deploy.sh
API_IMAGE=
WEB_IMAGE=

# --- backups (used by backup.sh / offsite-check.sh, not by compose; must not reach the API) ---
# s3:https://s3.<region>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=
# openssl rand -hex 32
RESTIC_PASSWORD=
# the Backblaze B2 application key for that bucket only
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# healthchecks.io ping URLs: hourly backup, weekly restore check
BACKUP_PING_URL=
RESTORE_PING_URL=
