# The API's own optional secrets, copied to /opt/bookedup/api.env (mode 600), read through env_file.
# A line that is absent stays unset; an empty value is refused by the API's env check. A copy lives in the
# password manager. WhatsApp and Web Push stay unset (D4).

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 32  (Telegram allows only A-Za-z0-9_-)
TELEGRAM_WEBHOOK_SECRET=

# Password reset emails (P1, step R18):
# RESEND_API_KEY=
# MAIL_FROM=
