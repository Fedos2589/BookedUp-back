PORT=3000
DATABASE_URL="postgresql://bookedup:bookedup@localhost:5432/bookedup?schema=public"
REDIS_URL="redis://localhost:6379"
# Reverse proxies in front of the API (0 locally, 1 behind one nginx or load balancer).
TRUST_PROXY=0
# Session cookie: Secure `__Host-sid` (true, the default; localhost works over HTTP too).
# false only to sign in over plain HTTP from another host, e.g. a phone on the LAN: the
# cookie becomes `sid` without Secure. Refused in production.
SESSION_COOKIE_SECURE=true
# The front's address, for links the API hands out (invitations). Required in production;
# elsewhere it defaults to the Vite dev server.
APP_URL=http://localhost:5173
# The notifications queue (reminders, sending): one running process is enough. false turns it off here.
NOTIFICATIONS_WORKER=true
# Telegram bot (create it with @BotFather). The token and the username go together; without them the
# channel is off (in development its messages go to the log). The secret is for the webhook.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# Web Push (the browser's notifications). All three or none. Make the keys with `npx web-push generate-vapid-keys`;
# the subject is a mailto: or https URL. Without them the channel is off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# WhatsApp Cloud API (Meta). The access token and the sending number's id go together; without them the channel is
# off. It sends approved templates only (bookedup_<kind>_client, ru and en).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Email through Resend. The API key and the sender go together; without them the channel is off (in production it is
# not replaced by the log).
# RESEND_API_KEY=
# MAIL_FROM=BookedUp <no-reply@example.com>
