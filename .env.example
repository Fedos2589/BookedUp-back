PORT=3000
DATABASE_URL="postgresql://bookedup:bookedup@localhost:5432/bookedup?schema=public"
REDIS_URL="redis://localhost:6379"
# Reverse proxies in front of the API (0 locally, 1 behind one nginx or load balancer).
TRUST_PROXY=0
# Session cookie: Secure `__Host-sid` (true, the default; localhost works over HTTP too).
# false only to sign in over plain HTTP from another host, e.g. a phone on the LAN: the
# cookie becomes `sid` without Secure. Refused in production.
SESSION_COOKIE_SECURE=true
# The front's address, for links the API hands out (invitations). Required in production;
# elsewhere it defaults to the Vite dev server.
APP_URL=http://localhost:5173
