// Data model. Rules every table follows (checked by test/schema.int-spec.ts):
// - a table that holds a business's data has a required `business_id`; only the
//   global tables (`businesses`, `users` and their sign-in methods) don't;
// - every timestamp is `timestamptz`: stored in UTC, shown in the business's time zone;
// - defaults live in the database (`uuidv7()`, `now()`), so raw SQL inserts work too.
//   `updated_at` moves on updates made through Prisma only.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ScheduleMode {
  HOURS
  GROUPS
}

enum MemberRole {
  OWNER
  ADMIN
  MASTER

  @@map("member_role")
}

/// A business on BookedUp — the tenant.
model Business {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  /// Address of the public booking page: /book/<slug>. Lowercase latin, digits and single
  /// hyphens (a CHECK constraint enforces it), so uniqueness is case-insensitive.
  slug            String   @unique
  /// IANA time zone, e.g. Europe/Moscow. Slots and reports are computed in it.
  timeZone        String   @map("time_zone")
  /// Minutes before a booking at which its client is reminded: 0 to 3 of 60, 120, 180, 1440, 2880
  /// (a CHECK constraint enforces the list). Empty = no reminders.
  reminderOffsets Int[]    @default([1440]) @map("reminder_offsets")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations              Location[]
  memberships            Membership[]
  staff                  Staff[]
  invitations            Invitation[]
  weeklyWindows          WeeklyWindow[]
  dayOverrides           DayOverride[]
  groups                 Group[]
  groupCancellations     GroupCancellation[]
  oneOffSessions         OneOffSession[]
  timeOffs               TimeOff[]
  appointments           Appointment[]
  clients                Client[]
  clientChannels         ClientChannel[]
  linkTokens             ChannelLinkToken[]
  notificationEvents     NotificationEvent[]
  notificationDeliveries NotificationDelivery[]

  @@map("businesses")
}

/// A branch of a business.
model Location {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  address    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("locations")
}

/// A person's account. Global: one account can belong to several businesses.
/// How they sign in lives in separate tables, one per method (password now, Google
/// later), each with only required columns; registration creates the user and at least
/// one of them in one transaction.
model User {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Always lowercase (a CHECK constraint enforces it), so uniqueness is case-insensitive.
  email       String   @unique
  name        String
  /// Interface language: `en` or `ru` (a CHECK constraint enforces the list, see src/account/locale.ts).
  locale      String   @default("en")
  /// The account's email channel for notifications (E9): its address is `email`.
  notifyEmail Boolean  @default(true) @map("notify_email")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordLogin   PasswordLogin?
  memberships     Membership[]
  sessions        Session[]
  invitationsSent Invitation[]
  channels        UserChannel[]
  linkTokens      ChannelLinkToken[]
  passwordResets  PasswordReset[]

  @@map("users")
}

/// Sign-in by email and password. At most one per user.
model PasswordLogin {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_logins")
}

/// A signed-in browser, kept by @nestjs/authentication through PrismaSessionStore. The id is
/// the SHA-256 of the cookie token, never the token; times come from the package's clock.
/// A one-time link to set a new password (E21 P1). Global, like `sessions`; only the token's hash is stored.
/// Expired rows go when the user asks again or resets: a tiny table, no purge job.
model PasswordReset {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Session {
  id           String           @id
  userId       String           @map("user_id") @db.Uuid
  createdAt    DateTime         @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime         @map("last_active_at") @db.Timestamptz(3)
  mfa          SessionMfaState?
  /// App data for a "your sessions" page (user agent and the like).
  metadata     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// The package's MfaState, spelled as it spells it.
enum SessionMfaState {
  pending
  verified

  @@map("session_mfa_state")
}

/// A user's role in one business. What the access guard checks.
/// Every business has exactly one OWNER, enforced in the database (init migration): a
/// partial unique index, and a deferred trigger checked at commit. So a business is
/// created together with its owner, and ownership is handed over by demoting the old
/// owner and promoting the new one in one transaction.
model Membership {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String     @map("business_id") @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  role            MemberRole
  /// Owner / admin: get every online booking, move and cancel of the business (E9).
  notifyAllOnline Boolean    @default(true) @map("notify_all_online")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff    Staff?

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

/// Someone who takes clients: a column in the schedule. Not who may sign in — that is
/// Membership. A master without an account is a Staff with no user (an admin keeps their
/// schedule); an owner or admin who takes clients too is a member with a Staff linked to them.
model Staff {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String       @map("business_id") @db.Uuid
  name         String
  /// The account behind this schedule, if any. The foreign key goes to the membership, not
  /// to the user, so it can only be a member of this same business.
  userId       String?      @map("user_id") @db.Uuid
  /// Left the team. Kept, not deleted: past bookings (E6) point at it.
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(3)
  /// What clients book with this master: hours cut into one-person slots, or groups. The
  /// other mode's schedule is kept, and left out of the slots.
  scheduleMode ScheduleMode @default(HOURS) @map("schedule_mode")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitations    Invitation[]
  weeklyWindows  WeeklyWindow[]
  dayOverrides   DayOverride[]
  groups         Group[]
  oneOffSessions OneOffSession[]
  timeOffs       TimeOff[]
  appointments   Appointment[]
  /// Removing a member who has a schedule unlinks it first (E3 step 2), in one transaction.
  membership     Membership?     @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: NoAction)

  /// What bookings reference together with business_id (AGENTS.md, «Связи внутри бизнеса»).
  @@unique([businessId, id])
  /// One schedule per account per business.
  @@unique([userId, businessId])
  @@map("staff")
}

/// A link to join a business with a role, given to the inviter to pass on (no email is sent
/// yet). Whoever holds it may accept it once, before it expires, unless it is revoked: the
/// accepting account becomes a member. Only the SHA-256 of the token is stored, like sessions.
/// Never OWNER, and never both accepted and revoked (CHECKs in the migration).
model Invitation {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  /// Who it is for, as the inviter wrote it: the list of pending invitations shows it.
  note        String?
  /// A schedule without an account, to link to whoever accepts.
  staffId     String?    @map("staff_id") @db.Uuid
  /// Gone when that account is deleted; the invitation stays good.
  invitedById String?    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Composite, so it can only be a schedule of this same business.
  staff     Staff?   @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: NoAction)
  invitedBy User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@map("invitations")
}

/// When a master takes clients, every week: from start_minute on the business's clock, for
/// duration_minutes (may run past midnight), cut into slots of slot_minutes (hours mode). Saved
/// as a whole week per master, which is where overlaps are refused (src/schedule).
model WeeklyWindow {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  /// ISO: 1 is Monday, 7 is Sunday.
  weekday         Int      @db.SmallInt
  startMinute     Int      @map("start_minute") @db.SmallInt
  durationMinutes Int      @map("duration_minutes") @db.SmallInt
  slotMinutes     Int      @map("slot_minutes") @db.SmallInt
  title           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// A template, not history: it goes with its schedule.
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId])
  @@map("weekly_windows")
}

/// Hours mode: a date whose windows replace the weekly ones that start on it. No windows is
/// a day off. One per master and date (the business's calendar).
model DayOverride {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  date       DateTime @db.Date
  /// [{ startMinute, durationMinutes, slotMinutes }], checked by the API's schema.
  windows    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  /// With business_id, so a write by it filters by the business like every other query.
  @@unique([businessId, staffId, date])
  @@map("day_overrides")
}

/// Groups mode: a named session on some weekdays at one time, for up to `capacity` people.
/// Groups of one master never overlap (checked in src/schedule under a lock on the staff row).
model Group {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  staffId         String    @map("staff_id") @db.Uuid
  title           String
  /// What it is, how to get ready, what to bring.
  description     String?
  /// ISO: 1 is Monday, 7 is Sunday.
  weekdays        Int[]     @db.SmallInt
  startMinute     Int       @map("start_minute") @db.SmallInt
  durationMinutes Int       @map("duration_minutes") @db.SmallInt
  capacity        Int       @db.SmallInt
  /// Deleted from the app: kept, because bookings point at it.
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff         Staff               @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  cancellations GroupCancellation[]
  appointments  Appointment[]

  @@unique([businessId, id])
  /// What a seat references, so it can't point at a group of another master.
  @@unique([businessId, staffId, id])
  @@index([businessId, staffId])
  @@map("groups")
}

/// A date a group does not meet (the business's calendar).
model GroupCancellation {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [businessId, groupId], references: [businessId, id], onDelete: Cascade)

  @@unique([groupId, date])
  @@map("group_cancellations")
}

/// Groups mode: a session once, between two instants. Overlapping ones of one master are
/// refused by an EXCLUDE constraint in the migration; one over a group's meeting by src/schedule.
model OneOffSession {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(3)
  capacity    Int       @db.SmallInt
  /// Deleted from the app: kept, because bookings point at it; its time is free again.
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  appointments Appointment[]

  @@unique([businessId, id])
  @@unique([businessId, staffId, id])
  @@index([businessId, staffId, startsAt])
  @@map("one_off_sessions")
}

/// Time a master can't be booked (leave, sick day, a break), taken out of every window.
model TimeOff {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId, startsAt])
  @@map("time_offs")
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  DONE
  NO_SHOW
  CANCELLED

  @@map("appointment_status")
}

/// A client's booking with a master: an hours slot, or one seat in a group meeting or a
/// one-off session (then `groupId` / `oneOffSessionId` is set). The client is a name and a
/// phone for now; E8 adds Client. Active bookings of one master never overlap, except seats
/// of one meeting (EXCLUDE in the migration); seats are counted against `capacity` by src/appointments under
/// a lock on the staff row. Kept after the master leaves: the foreign keys refuse a delete (NO ACTION).
model Appointment {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String            @map("business_id") @db.Uuid
  staffId         String            @map("staff_id") @db.Uuid
  clientId        String            @map("client_id") @db.Uuid
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(3)
  status          AppointmentStatus @default(BOOKED)
  /// Who booked, as it was then: written once, a later edit of the client doesn't touch it.
  clientName      String            @map("client_name")
  /// E.164. The person's phone, or their guardian's.
  clientPhone     String            @map("client_phone")
  note            String?
  groupId         String?           @map("group_id") @db.Uuid
  oneOffSessionId String?           @map("one_off_session_id") @db.Uuid
  /// SHA-256 of the private link's token: only a booking made online has one (E7).
  manageTokenHash String?           @unique @map("manage_token_hash")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff              Staff               @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: NoAction, onUpdate: NoAction)
  client             Client              @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: NoAction, onUpdate: NoAction)
  channels           ClientChannel[]
  linkTokens         ChannelLinkToken[]
  notificationEvents NotificationEvent[]
  group              Group?              @relation(fields: [businessId, staffId, groupId], references: [businessId, staffId, id], onDelete: NoAction, onUpdate: NoAction)
  oneOffSession      OneOffSession?      @relation(fields: [businessId, staffId, oneOffSessionId], references: [businessId, staffId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([businessId, id])
  @@index([businessId, startsAt])
  @@index([businessId, groupId, startsAt])
  @@index([businessId, oneOffSessionId])
  @@index([businessId, staffId, startsAt])
  @@index([businessId, clientId, startsAt])
  @@map("appointments")
}

/// One person of a business. Either an account holder with their own `phone`, or a dependent
/// (a child, a relative without a phone) with a `guardianId` pointing at a holder: exactly one of
/// the two (CHECK `clients_phone_or_guardian`). That a guardian is always a holder, and a holder
/// with dependents keeps their phone, is the trigger `clients_guardian_is_holder` in the migration.
model Client {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  /// E.164. NULL for a dependent; Postgres treats NULLs as distinct, so they don't collide.
  phone      String?
  guardianId String?  @map("guardian_id") @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  guardian     Client?         @relation("Guardian", fields: [businessId, guardianId], references: [businessId, id], onDelete: NoAction, onUpdate: NoAction)
  dependents   Client[]        @relation("Guardian")
  appointments Appointment[]
  channels     ClientChannel[]

  /// What bookings reference together with business_id (AGENTS.md, «Связи внутри бизнеса»).
  @@unique([businessId, id])
  /// One account per phone per business.
  @@unique([businessId, phone])
  @@index([businessId, guardianId])
  @@map("clients")
}

/// Where a message can go (E9). LOG is the development and test channel: it only writes the log.
enum ChannelKind {
  EMAIL
  TELEGRAM
  WHATSAPP
  PUSH
  LOG
}

enum NotificationKind {
  BOOKED
  MOVED
  CANCELLED
  REMINDER
  CHANNEL_ON
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// A channel of a staff account, for every business it is a member of. Its email is `users.email`
/// (+ `notify_email`), so only TELEGRAM, WHATSAPP and PUSH are stored (CHECK `user_channels_kind`);
/// at most one TELEGRAM and one WHATSAPP per account are partial unique indexes in the migration.
model UserChannel {
  id        String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      ChannelKind
  /// Chat id / E.164 / push endpoint.
  address   String
  /// Push: `p256dh` and `auth`.
  keys      Json?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, address])
  @@map("user_channels")
}

/// A one-time link that turns a Telegram chat on (`t.me/<bot>?start=<token>`): for a member's account
/// (`userId`) or for an online booking (`appointmentId`, with its business) — exactly one of them (CHECK).
/// Only the hash is stored. `manageLink` is the booking's own link, for the CHANNEL_ON message.
model ChannelLinkToken {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  businessId    String?  @map("business_id") @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  /// `en` or `ru` (CHECK).
  locale        String
  manageLink    String?  @map("manage_link")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("channel_link_tokens")
}

/// A client signing in to book online: a phone proved through Telegram (E7b). The nonce travels in the
/// `t.me/<bot>?start=<nonce>` link, the browser secret stays in a cookie; only their hashes are stored, so
/// neither alone yields a session. Global, like `sessions`: a phone is not one business's client (D9).
model ClientLogin {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nonceHash   String    @unique @map("nonce_hash")
  browserHash String    @unique @map("browser_hash")
  /// `en` or `ru` (CHECK).
  locale      String
  /// Four digits (CHECK): shown on the page and by the bot so a person can compare; never verified.
  code        String
  chatId      String?   @map("chat_id")
  /// E.164 (CHECK).
  phone       String?
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([chatId])
  @@map("client_logins")
}

/// A client's session on the public pages, opened by a confirmed `ClientLogin`; only the token's hash is
/// stored. Global (D9). `expiresAt` slides forward on use.
model ClientSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  /// E.164 (CHECK).
  phone      String
  chatId     String   @map("chat_id")
  /// The language of the sign-in (`en` or `ru`, CHECK): the one the client's Telegram messages come in.
  locale     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([phone])
  @@map("client_sessions")
}

/// A channel of a client. WHATSAPP always sits on the client card (the phone), PUSH and EMAIL always on
/// the booking whose manage link turned them on, TELEGRAM on either: on the card when the client signed in
/// through Telegram to book online (E7b, D8), on a booking when its manage link turned it on (CHECK
/// `client_channels_placement`).
/// The unique key `(business_id, client_id, kind, address, appointment_id) NULLS NOT DISTINCT`
/// is in the migration, Prisma can't express it.
model ClientChannel {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId    String      @map("business_id") @db.Uuid
  clientId      String      @map("client_id") @db.Uuid
  appointmentId String?     @map("appointment_id") @db.Uuid
  kind          ChannelKind
  /// Chat id / E.164 / push endpoint / email (at most 254).
  address       String
  keys          Json?
  /// `en` or `ru` (CHECK).
  locale        String
  /// Switched off (the client turned it off, or it was unreachable): the row stays, because its events and
  /// deliveries hang on it. Nothing is sent to it; turning it on again clears the mark.
  disabledAt    DateTime?   @map("disabled_at") @db.Timestamptz(3)
  /// Switched off by the client themselves («don't write to me»), as opposed to the dispatcher finding the
  /// address unreachable: only the second comes back when the same chat answers again. Needs `disabledAt`
  /// (CHECK); turning the channel on again clears both.
  optedOutAt    DateTime?   @map("opted_out_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)
  appointment Appointment?        @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)
  events      NotificationEvent[]

  @@unique([businessId, id])
  /// Declared so Prisma knows the index; the migration creates it NULLS NOT DISTINCT (a WhatsApp row has
  /// no booking), which the schema can't say.
  @@unique([businessId, clientId, kind, address, appointmentId], map: "client_channels_address_key")
  @@index([businessId, clientId])
  @@index([businessId, appointmentId])
  @@map("client_channels")
}

/// Outbox: a booking's change, written in the same transaction as the change (E9, decision 1).
model NotificationEvent {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId    String           @map("business_id") @db.Uuid
  appointmentId String           @map("appointment_id") @db.Uuid
  kind          NotificationKind
  /// Who made the change; NULL = the client online or the system.
  actorUserId   String?          @map("actor_user_id") @db.Uuid
  /// The booking's start when the event was written.
  startsAt      DateTime         @map("starts_at") @db.Timestamptz(3)
  /// REMINDER only (CHECK `notification_events_offset`).
  offsetMinutes Int?             @map("offset_minutes")
  /// CHANNEL_ON only (CHECK `notification_events_channel`): the channel just turned on.
  channelId     String?          @map("channel_id") @db.Uuid
  /// CHANNEL_ON: `{ manageLink }`, wiped once sent (decision 5).
  payload       Json?
  processedAt   DateTime?        @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment            @relation(fields: [businessId, appointmentId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)
  channel     ClientChannel?         @relation(fields: [businessId, channelId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)
  deliveries  NotificationDelivery[]

  @@unique([businessId, id])
  @@map("notification_events")
}

/// One message to one address: unique per `(event, channel, address, audience)`, claimed before the call to
/// the outside service (E9, decision 3).
model NotificationDelivery {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  eventId    String         @map("event_id") @db.Uuid
  channel    ChannelKind
  address    String
  /// `client` or `staff` (CHECK).
  audience   String
  /// `en` or `ru` (CHECK).
  locale     String
  status     DeliveryStatus @default(PENDING)
  attempts   Int            @default(0)
  lastError  String?        @map("last_error")
  /// A FAILED delivery is not tried again before this time.
  retryAt    DateTime?      @map("retry_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt     DateTime?      @map("sent_at") @db.Timestamptz(3)

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event    NotificationEvent @relation(fields: [businessId, eventId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, channel, address, audience])
  @@map("notification_deliveries")
}
