// Data model. Rules every table follows (checked by test/schema.int-spec.ts):
// - a table that holds a business's data has a required `business_id`; only the
//   global tables (`businesses`, `users` and their sign-in methods) don't;
// - every timestamp is `timestamptz`: stored in UTC, shown in the business's time zone;
// - defaults live in the database (`uuidv7()`, `now()`), so raw SQL inserts work too.
//   `updated_at` moves on updates made through Prisma only.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ScheduleMode {
  HOURS
  GROUPS
}

enum MemberRole {
  OWNER
  ADMIN
  MASTER

  @@map("member_role")
}

/// A business on BookedUp — the tenant.
model Business {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  /// Address of the public booking page: /book/<slug>. Lowercase latin, digits and single
  /// hyphens (a CHECK constraint enforces it), so uniqueness is case-insensitive.
  slug      String   @unique
  /// IANA time zone, e.g. Europe/Moscow. Slots and reports are computed in it.
  timeZone  String   @map("time_zone")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  locations          Location[]
  memberships        Membership[]
  staff              Staff[]
  invitations        Invitation[]
  weeklyWindows      WeeklyWindow[]
  dayOverrides       DayOverride[]
  groups             Group[]
  groupCancellations GroupCancellation[]
  oneOffSessions     OneOffSession[]
  timeOffs           TimeOff[]

  @@map("businesses")
}

/// A branch of a business.
model Location {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  address    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("locations")
}

/// A person's account. Global: one account can belong to several businesses.
/// How they sign in lives in separate tables, one per method (password now, Google
/// later), each with only required columns; registration creates the user and at least
/// one of them in one transaction.
model User {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Always lowercase (a CHECK constraint enforces it), so uniqueness is case-insensitive.
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordLogin   PasswordLogin?
  memberships     Membership[]
  sessions        Session[]
  invitationsSent Invitation[]

  @@map("users")
}

/// Sign-in by email and password. At most one per user.
model PasswordLogin {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_logins")
}

/// A signed-in browser, kept by @nestjs/authentication through PrismaSessionStore. The id is
/// the SHA-256 of the cookie token, never the token; times come from the package's clock.
model Session {
  id           String           @id
  userId       String           @map("user_id") @db.Uuid
  createdAt    DateTime         @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime         @map("last_active_at") @db.Timestamptz(3)
  mfa          SessionMfaState?
  /// App data for a "your sessions" page (user agent and the like).
  metadata     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// The package's MfaState, spelled as it spells it.
enum SessionMfaState {
  pending
  verified

  @@map("session_mfa_state")
}

/// A user's role in one business. What the access guard checks.
/// Every business has exactly one OWNER, enforced in the database (init migration): a
/// partial unique index, and a deferred trigger checked at commit. So a business is
/// created together with its owner, and ownership is handed over by demoting the old
/// owner and promoting the new one in one transaction.
model Membership {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  role       MemberRole
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff    Staff?

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

/// Someone who takes clients: a column in the schedule. Not who may sign in — that is
/// Membership. A master without an account is a Staff with no user (an admin keeps their
/// schedule); an owner or admin who takes clients too is a member with a Staff linked to them.
model Staff {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String       @map("business_id") @db.Uuid
  name         String
  /// The account behind this schedule, if any. The foreign key goes to the membership, not
  /// to the user, so it can only be a member of this same business.
  userId       String?      @map("user_id") @db.Uuid
  /// Left the team. Kept, not deleted: past bookings (E6) point at it.
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(3)
  /// What clients book with this master: hours cut into one-person slots, or groups. The
  /// other mode's schedule is kept, and left out of the slots.
  scheduleMode ScheduleMode @default(HOURS) @map("schedule_mode")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitations    Invitation[]
  weeklyWindows  WeeklyWindow[]
  dayOverrides   DayOverride[]
  groups         Group[]
  oneOffSessions OneOffSession[]
  timeOffs       TimeOff[]
  /// Removing a member who has a schedule unlinks it first (E3 step 2), in one transaction.
  membership     Membership?     @relation(fields: [userId, businessId], references: [userId, businessId], onDelete: NoAction)

  /// What bookings (E6) will reference together with business_id (AGENTS.md, «Связи внутри бизнеса»).
  @@unique([businessId, id])
  /// One schedule per account per business.
  @@unique([userId, businessId])
  @@map("staff")
}

/// A link to join a business with a role, given to the inviter to pass on (no email is sent
/// yet). Whoever holds it may accept it once, before it expires, unless it is revoked: the
/// accepting account becomes a member. Only the SHA-256 of the token is stored, like sessions.
/// Never OWNER, and never both accepted and revoked (CHECKs in the migration).
model Invitation {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  /// Who it is for, as the inviter wrote it: the list of pending invitations shows it.
  note        String?
  /// A schedule without an account, to link to whoever accepts.
  staffId     String?    @map("staff_id") @db.Uuid
  /// Gone when that account is deleted; the invitation stays good.
  invitedById String?    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Composite, so it can only be a schedule of this same business.
  staff     Staff?   @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: NoAction)
  invitedBy User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@map("invitations")
}

/// When a master takes clients, every week: from start_minute on the business's clock, for
/// duration_minutes (may run past midnight), cut into slots of slot_minutes (hours mode). Saved
/// as a whole week per master, which is where overlaps are refused (src/schedule).
model WeeklyWindow {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  /// ISO: 1 is Monday, 7 is Sunday.
  weekday         Int      @db.SmallInt
  startMinute     Int      @map("start_minute") @db.SmallInt
  durationMinutes Int      @map("duration_minutes") @db.SmallInt
  slotMinutes     Int      @map("slot_minutes") @db.SmallInt
  title           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// A template, not history: it goes with its schedule.
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId])
  @@map("weekly_windows")
}

/// Hours mode: a date whose windows replace the weekly ones that start on it. No windows is
/// a day off. One per master and date (the business's calendar).
model DayOverride {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  date       DateTime @db.Date
  /// [{ startMinute, durationMinutes, slotMinutes }], checked by the API's schema.
  windows    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  /// With business_id, so a write by it filters by the business like every other query.
  @@unique([businessId, staffId, date])
  @@map("day_overrides")
}

/// Groups mode: a named session on some weekdays at one time, for up to `capacity` people.
/// Groups of one master never overlap (checked in src/schedule under a lock on the staff row).
model Group {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  title           String
  /// What it is, how to get ready, what to bring.
  description     String?
  /// ISO: 1 is Monday, 7 is Sunday.
  weekdays        Int[]    @db.SmallInt
  startMinute     Int      @map("start_minute") @db.SmallInt
  durationMinutes Int      @map("duration_minutes") @db.SmallInt
  capacity        Int      @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff         Staff               @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  cancellations GroupCancellation[]

  @@unique([businessId, id])
  @@index([businessId, staffId])
  @@map("groups")
}

/// A date a group does not meet (the business's calendar).
model GroupCancellation {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [businessId, groupId], references: [businessId, id], onDelete: Cascade)

  @@unique([groupId, date])
  @@map("group_cancellations")
}

/// Groups mode: a session once, between two instants. Overlapping ones of one master are
/// refused by an EXCLUDE constraint in the migration; one over a group's meeting by src/schedule.
model OneOffSession {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(3)
  capacity    Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId, startsAt])
  @@map("one_off_sessions")
}

/// Time a master can't be booked (leave, sick day, a break), taken out of every window.
model TimeOff {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)

  @@index([businessId, staffId, startsAt])
  @@map("time_offs")
}
